{
  "name": "@laira/providers",
  "version": "0.1.0",
  "description": "Safe provider adapters for Liara Cloud and BoxAPI Qwen3.7 Flash / GPT-5.4 Mini",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./liara": {
      "types": "./dist/liara/index.d.ts",
      "import": "./dist/liara/index.js",
      "default": "./dist/liara/index.js"
    },
    "./liara/operational": {
      "types": "./dist/liara/operational.d.ts",
      "import": "./dist/liara/operational.js",
      "default": "./dist/liara/operational.js"
    },
    "./boxapi": {
      "types": "./dist/boxapi/index.d.ts",
      "import": "./dist/boxapi/index.js",
      "default": "./dist/boxapi/index.js"
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": "./dist/schema/index.js",
      "default": "./dist/schema/index.js"
    },
    "./cli/smoke": {
      "types": "./dist/cli/smoke.d.ts",
      "import": "./dist/cli/smoke.js",
      "default": "./dist/cli/smoke.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node dist/cli/smoke.js"
  },
  "dependencies": {
    "openai": "4.86.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  }
}
