{
  "name": "liara-agentic-devops",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --recursive run build",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "node --test scripts/test-database.test.mjs && vitest run",
    "test:unit": "node --test scripts/test-database.test.mjs && vitest run",
    "test:integration": "node --env-file=.env scripts/test-integration.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  },
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9.0.0"
  }
}
