# Copy to .env. Never commit .env or paste secret values into chat.
NODE_ENV=development
AUTH_URL=http://localhost:3000
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Numeric GitHub provider ID, verified at login, not a username/email assertion.
DEMO_OWNER_GITHUB_ID=152868728

# Local isolated services; generated credentials must match compose configuration.
POSTGRES_PORT=55433
POSTGRES_USER=laira
POSTGRES_PASSWORD=
POSTGRES_DB=laira
DATABASE_URL=
TEST_DATABASE_URL=
MINIO_ROOT_USER=laira-local
MINIO_ROOT_PASSWORD=
S3_ENDPOINT=http://localhost:59000
S3_REGION=us-east-1
S3_BUCKET=laira-private
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 32 random bytes, base64 encoded (confirm envelope package configuration).
ENCRYPTION_MASTER_KEY=

# Operator demo credentials. Never substitute these after a failed customer BYOK.
BOX_API_KEY=
# Explicit user-selected model for the current restricted key; no runtime fallback.
BOX_MODEL=openai/gpt-5.4-mini
LIARA_API_TOKEN=
LIARA_TEAM_ID=
# Optional owner-only app creation catalog. Empty means provisioning proposals disabled.
# JSON array entries: {"planId":"account-plan","bundlePlanId":"account-feature-bundle","networkId":"000000000000000000000000","platform":"next","cost":{"currency":"IRR","hourly":1,"monthly":720,"sourceUrl":"https://api.liara.ir/v1/me","checkedAt":"2026-01-01T00:00:00.000Z"}}
# Verify current account availability and total plan+bundle cost before supplying values.
LIARA_APPROVED_APP_PLANS_JSON=
# No production bypass: fixture UI is separate and does not access live credentials.
