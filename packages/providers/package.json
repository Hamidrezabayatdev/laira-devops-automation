{
  "name": "@laira/providers",
  "version": "0.1.0",
  "description": "Safe provider adapters for Liara Cloud and BoxAPI Qwen3.7 Flash / GPT-5.4 Mini",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./liara": "./src/liara/index.ts",
    "./boxapi": "./src/boxapi/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "test:vitest": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node --experimental-strip-types src/cli/smoke.ts"
  },
  "dependencies": {
    "openai": "4.86.1",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.2",
    "vitest": "3.2.7"
  }
}
