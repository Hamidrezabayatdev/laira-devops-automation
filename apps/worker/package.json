    "@laira/security": "workspace:*",
    "@laira/source": "workspace:*",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "zod": "3.24.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "typescript": "5.8.2"
